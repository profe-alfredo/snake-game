oth.onBluetoothDisconnected(function () {\n    basic.showIcon(IconNames.Sad)\n    basic.pause(2000)\n})\n\nbluetooth.onUartDataReceived(\"A\", function () {\n    if (x_add == 0) {\n        x_add = -1\n        y_add = 0\n    } else if (y_add == 0) {\n        x_add = 0\n        y_add = -1\n    }\n})\nlet x_add = 0\nlet y1 = 0\nlet x1 = 0\nlet y = 0\nlet x = 0\nlet arr: number[] = []\nlet wait = 0\nlet y_add = 0\nlet treasure_y = 0\nlet treasure_x = 0\ntreasure_x = randint(0, 4)\ntreasure_y = randint(0, 4)\ny_add = 1\nwait = 200\narr = [0]\nbluetooth.startUartService()\nbasic.forever(function () {\n    showTreasure()\n})\nbasic.forever(function () {\n    generateImage()\n    moveForward()\n})\n\ninput.onButtonPressed(Button.A, function () {\n    if (x_add == 0 && y_add == -1) {\n        x_add = -1\n        y_add = 0\n    } else if (x_add == 0 && y_add == 1) {\n        x_add = 1\n        y_add = 0\n    } else if (x_add == 1 && y_add == 0){\n        x_add = 0\n        y_add = -1\n    } else {\n        x_add = 0\n        y_add = 1\n    }\n})\n\ninput.onButtonPressed(Button.B, function () {\n    if (x_add == 0 && y_add == -1) {\n        x_add = 1\n        y_add = 0\n    } else if (x_add == 0 && y_add == 1) {\n        x_add = -1\n        y_add = 0\n    } else if (x_add == 1 && y_add == 0) {\n        x_add = 0\n        y_add = 1\n    } else {\n        x_add = 0\n        y_add = -1\n    }\n})\n\ninput.onButtonPressed(Button.AB, function () {\n    arr = [0]\n})","README.md":"","pxt.json":"{\n    \"name\": \"Snake Game\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"microphone\": \"*\",\n        \"bluetooth\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\",\n    \"yotta\": {\n        \"config\": {\n            \"microbit-dal\": {\n                \"bluetooth\": {\n                    \"open\": 1,\n                    \"whitelist\": 0,\